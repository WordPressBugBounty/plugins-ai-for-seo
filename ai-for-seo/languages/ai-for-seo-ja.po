#: includes/pages/settings.php:1729
msgid "<strong>Available placeholders</strong> (case-insensitive):<br>{WEBSITE_URL} - Site URL.<br>{WEBSITE_NAME} - Site name.<br>{FILE_NAME} - File name without extension.<br>{FILE_TYPE} - File extension.<br>{FILE_SIZE} - File size in kilobytes.<br>{IMAGE_DIMENSIONS} - Image width x height.<br><br>Placeholders are replaced when attributes are saved or injected into the frontend."
msgstr "<strong>使用可能なプレースホルダー</strong>(大文字と小文字は区別されません):<br>{WEBSITE_URL}- サイトURL。<br>{WEBSITE_NAME}- サイト名。<br>{FILE_NAME}- 拡張子なしのファイル名。<br>{FILE_TYPE}- ファイル拡張子。<br>{FILE_SIZE}- ファイル サイズ (キロバイト単位)。<br>{IMAGE_DIMENSIONS}- 画像の幅 x 高さ。<br><br>プレースホルダーは、属性が保存されるかフロントエンドに挿入されるときに置き換えられます。"

#: includes/pages/settings.php:1213
msgid "Choose how WooCommerce product prices should be handled in generated metadata: never include them, store a fixed price, or use a dynamic placeholder that updates at render time."
msgstr "生成するメタデータで WooCommerce の商品価格を処理する方法を選択してください: 価格を含めない、現在の価格を固定して保存する、または表示時に更新される動的なプレースホルダーを使用します。"

#: includes/pages/settings.php:1199
msgid "Include product price in metadata"
msgstr "メタデータに商品価格を含める"

#: includes/pages/settings.php:956
msgid "<strong>Available placeholders</strong> (case-insensitive; supports {PLACEHOLDER}, [PLACEHOLDER], or %%placeholder%% formats):<br>WEBSITE_URL - Site URL.<br>WEBSITE_NAME - Site name.<br>POST_ID - Current entry ID.<br>TITLE - Current entry title.<br>PRODUCT_NAME - WooCommerce product title (products only).<br>PRODUCT_PRICE - WooCommerce product price (products only).<br><br>Placeholders are replaced automatically when meta tags are injected on the frontend."
msgstr "<strong>使用可能なプレースホルダー</strong> (大文字と小文字を区別しません。{PLACEHOLDER}、[PLACEHOLDER]、%%placeholder%% 形式に対応):<br>WEBSITE_URL - サイト URL。<br>WEBSITE_NAME - サイト名。<br>POST_ID - 現在の項目 ID。<br>TITLE - 現在の項目のタイトル。<br>PRODUCT_NAME - WooCommerce の商品タイトル (商品のみ)。<br>PRODUCT_PRICE - WooCommerce の商品価格 (商品のみ)。<br><br>フロントエンドでメタタグを挿入する際に、プレースホルダーを自動的に置き換えます。"

