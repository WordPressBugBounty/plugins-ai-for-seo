#: includes/core/custom-instructions.php:282
msgid "End social media descriptions with this CTA: \"Join us now!\""
msgstr "Termina las descripciones de redes sociales con esta llamada a la acción: \"¡Únete ahora!\""

#: includes/core/custom-instructions.php:281
msgid "Include the article number in the meta description."
msgstr "Incluye el número de artículo en la metadescripción."

#: includes/core/custom-instructions.php:280
msgid "Always include the city this post is about in the focus keyphrase and meta title."
msgstr "Incluye siempre la ciudad sobre la que trata esta entrada en la frase clave de enfoque y el metatítulo."

