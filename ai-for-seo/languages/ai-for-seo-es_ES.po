msgid "Free plan"
msgstr "Plan gratuito"

#. translators: %s: plugin name
#: includes/pages/help.php:813
msgid "<b>Alternatively,</b> you can go to the \"Pages\" or \"Posts\" page within the *%s* plugin. From there, you can browse through your pages and posts, and choose the ones you want to edit."
msgstr "<b>Alternatively,</b> puede ir a la página \"Pages\" o \"Posts\" dentro del plugin *%s*. Desde allí, puede navegar por sus páginas y entradas y elegir las que desea editar."

#. translators: %s: plugin name
#: includes/pages/help.php:804
msgid "Click on the *%s* button located in the top admin-bar. This will open up the Metadata Editor."
msgstr "Haga clic en el botón *%s* ubicado en la barra de administración superior. Esto abrirá Metadata Editor."

#: includes/pages/help.php:800
msgid "Navigate to the page or post you want to edit. You can do this through the normal editor, using a page builder like Elementor, or by opening the page directly in the frontend."
msgstr "Navega a la página o publicación que deseas editar. Puedes hacer esto a través del editor normal, usando un creador de páginas como Elementor o abriendo la página directamente en la interfaz."

