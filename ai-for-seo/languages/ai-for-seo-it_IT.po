msgid "<strong>Replace (Recommended):</strong> Replaces existing meta tags, preventing duplicates and cleaning HTML header."
msgstr "<strong>Sostituisci (consigliato):</strong> Sostituisce i meta tag esistenti, evita duplicati e pulisce l'header HTML."

#: includes/pages/settings.php:1296
msgid "<strong>Force:</strong> Outputs plugin meta tags regardless of other plugins. May create duplicates."
msgstr "<strong>Force:</strong> Restituisce i meta tag del plugin indipendentemente dagli altri plugin. Può creare duplicati."

#: includes/pages/settings.php:1292
msgid "<strong>Disable:</strong> Disables all plugin meta tags. Only useful when completely syncing to other SEO plugins."
msgstr "<strong>Disable:</strong> Disabilita tutti i meta tag del plugin. Utile solo durante la sincronizzazione completa con altri plugin SEO."

