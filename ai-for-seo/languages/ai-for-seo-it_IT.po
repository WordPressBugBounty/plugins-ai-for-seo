msgid "This entry is currently being processed."
msgstr "Questa voce è attualmente in elaborazione."

#: includes/pages/content_types/attachment.php:918
#: includes/pages/content_types/post.php:711
msgid "Queued, but SEO Autopilot is deactivated for this content type."
msgstr "In coda, ma SEO Autopilot è disattivato per questo tipo di contenuto."

#: includes/pages/content_types/attachment.php:914
