#: includes/core/output.php:933
#: assets/js/ai-for-seo-scripts-2.6.0.js:8378
msgid "This value appears to have been changed by a user after it was generated."
msgstr "Questo valore sembra essere stato modificato da un utente dopo la generazione."

#. translators: %s: Plugin name.
#: includes/core/output.php:927
#: assets/js/ai-for-seo-scripts-2.6.0.js:14681
msgid "This field value was generated by %s."
msgstr "Il valore di questo campo è stato generato da %s."

#. translators: 1: Plugin name. 2: Generated-at date and time.
