#: includes/core/output.php:2347
#: includes/core/output.php:2378
#: includes/core/output.php:2409
#: includes/core/output.php:2440
#: includes/core/output.php:2472
#: includes/core/output.php:2503
#: includes/core/output.php:2540
msgid "Balanced"
msgstr "Equilibrato"

#: includes/core/output.php:2217
msgid "Use context only with very strong visual support. Add surrounding/page terms only when the image clearly confirms them."
msgstr "Usa il contesto solo con supporto visivo molto forte. Aggiungi termini circostanti/della pagina solo quando l'immagine li conferma chiaramente."

#: includes/core/output.php:2216
#: includes/core/output.php:2247
#: includes/core/output.php:2310
#: includes/core/output.php:2435
#: includes/core/output.php:2498
#: includes/core/output.php:2535
msgid "Careful"
msgstr "Prudente"

#: includes/core/output.php:2212
msgid "This could ignore useful page context, names, or topic clues that help identify the image correctly."
msgstr "Questo potrebbe ignorare contesto pagina, nomi o indizi tematici utili che aiutano a identificare correttamente l'immagine."

#: includes/core/output.php:2211
msgid "Avoid contextual framing. Treat usage/page context as language and disambiguation support only. Do not add contextual topics, purposes, names, or page-title details unless directly visible."
msgstr "Evita inquadramento contestuale. Tratta il contesto d'uso/pagina solo come supporto linguistico e di disambiguazione. Non aggiungere temi contestuali, scopi, nomi o dettagli del titolo pagina salvo che siano direttamente visibili."

