msgstr "Todos os dados gerados serão removidos porque todos os tipos de entrada estão selecionados."

#: includes/core/output.php:3264
msgid "Apply"
msgstr "Aplicar"

#: includes/core/output.php:3251
msgid "Bulk actions"
