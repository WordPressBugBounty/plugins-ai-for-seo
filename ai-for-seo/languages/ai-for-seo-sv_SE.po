msgid "Hidden entries"
msgstr "Dolda poster"

#: includes/pages/content_types/list-filters.php:26
msgid "In queue"
msgstr "I kö"

#: includes/pages/content_types/list-filters.php:25
msgid "Waiting to get queued"
msgstr "Väntar på att köläggas"

#: includes/pages/content_types/attachment.php:1015
#: includes/pages/content_types/post.php:827
msgid "Auto Queue will ignore this entry because it was excluded with a bulk action."
msgstr "Automatisk köläggning ignorerar den här posten eftersom den uteslöts med en massåtgärd."

#: includes/pages/content_types/attachment.php:973
#: includes/pages/content_types/post.php:784
msgid "This entry is currently being processed."
msgstr "Den här posten bearbetas för närvarande."

