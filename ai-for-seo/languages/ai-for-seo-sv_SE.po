#: includes/pages/content_types/attachment.php:963
#: includes/pages/content_types/post.php:757
msgid "Auto Queue will ignore this entry because it was excluded with a bulk action."
msgstr "Auto Queue ignorerar den här posten eftersom den uteslöts med en massåtgärd."

#: includes/pages/content_types/attachment.php:923
#: includes/pages/content_types/post.php:716
msgid "This entry is currently being processed."
msgstr "Den här posten bearbetas för närvarande."

#: includes/pages/content_types/attachment.php:918
#: includes/pages/content_types/post.php:711
msgid "Queued, but SEO Autopilot is deactivated for this content type."
msgstr "Kölagd, men SEO Autopilot är inaktiverat för den här innehållstypen."

#: includes/pages/content_types/attachment.php:914
