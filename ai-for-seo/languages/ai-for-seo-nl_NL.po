#: includes/pages/help.php:1198
#: includes/pages/help.php:1878
msgid "3. Clear caches (plugin/theme cache, page cache, CDN) so updated attributes render on cached pages."
msgstr "3. Wis caches (plug-in/thema-cache, paginacache, CDN) zodat bijgewerkte kenmerken worden weergegeven op in de cache opgeslagen pagina's."

#: includes/pages/help.php:1197
