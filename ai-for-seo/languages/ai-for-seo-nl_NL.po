#: includes/pages/settings.php:1729
msgid "<strong>Available placeholders</strong> (case-insensitive):<br>{WEBSITE_URL} - Site URL.<br>{WEBSITE_NAME} - Site name.<br>{FILE_NAME} - File name without extension.<br>{FILE_TYPE} - File extension.<br>{FILE_SIZE} - File size in kilobytes.<br>{IMAGE_DIMENSIONS} - Image width x height.<br><br>Placeholders are replaced when attributes are saved or injected into the frontend."
msgstr "<strong>Beschikbare tijdelijke aanduidingen</strong> (niet hoofdlettergevoelig):<br>{WEBSITE_URL} - Site-URL.<br>{WEBSITE_NAME} - Sitenaam.<br>{FILE_NAME} - Bestandsnaam zonder extensie.<br>{FILE_TYPE} - Bestandsextensie.<br>{FILE_SIZE} - Bestandsgrootte in kilobytes.<br>{IMAGE_DIMENSIONS} - Afbeeldingsbreedte x hoogte.<br><br>Tijdelijke aanduidingen worden vervangen wanneer attributen worden opgeslagen of in de frontend worden geïnjecteerd."

#: includes/pages/settings.php:1213
msgid "Choose how WooCommerce product prices should be handled in generated metadata: never include them, store a fixed price, or use a dynamic placeholder that updates at render time."
msgstr "Kies hoe WooCommerce-productprijzen moeten worden verwerkt in de gegenereerde metadata: neem ze nooit op, sla een vaste prijs op of gebruik een dynamische tijdelijke aanduiding die wordt bijgewerkt tijdens het renderen."

#: includes/pages/settings.php:1199
msgid "Include product price in metadata"
msgstr "Neem de productprijs op in de metadata"

#: includes/pages/settings.php:956
msgid "<strong>Available placeholders</strong> (case-insensitive; supports {PLACEHOLDER}, [PLACEHOLDER], or %%placeholder%% formats):<br>WEBSITE_URL - Site URL.<br>WEBSITE_NAME - Site name.<br>POST_ID - Current entry ID.<br>TITLE - Current entry title.<br>PRODUCT_NAME - WooCommerce product title (products only).<br>PRODUCT_PRICE - WooCommerce product price (products only).<br><br>Placeholders are replaced automatically when meta tags are injected on the frontend."
msgstr "<strong>Beschikbare tijdelijke aanduidingen</strong> (niet hoofdlettergevoelig; ondersteunt de formats {PLACEHOLDER}, [PLACEHOLDER] of %%placeholder%%):<br>WEBSITE_URL - Site-URL.<br>WEBSITE_NAME - Sitenaam.<br>POST_ID - Huidige vermelding-ID.<br>TITLE - Huidige titel van vermelding.<br>PRODUCT_NAME - WooCommerce producttitel (alleen producten).<br>PRODUCT_PRICE - WooCommerce productprijs (alleen producten).<br><br>Tijdelijke aanduidingen worden automatisch vervangen wanneer metatags in de frontend worden geïnjecteerd."

