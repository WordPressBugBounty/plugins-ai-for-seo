#. translators: %s: Plugin name.
#: includes/core/bulk-generation.php:422
msgid "Deletes active %s metadata saved for selected entries from wp_postmeta. Third-party SEO plugin data and generated-data markers are not deleted."
msgstr "Verwijdert actieve %s-metadata die voor geselecteerde items zijn opgeslagen uit wp_postmeta. Gegevens van externe SEO-plugins en markers voor gegenereerde gegevens worden niet verwijderd."

